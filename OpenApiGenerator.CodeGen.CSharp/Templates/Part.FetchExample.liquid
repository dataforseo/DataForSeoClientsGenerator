var dfsClient = new DataForSeoClient(new DataForSeoClientConfiguration()
{
    Username = "{{ operation.Login }}",
    Password = "{{ operation.Password }}",
    {%- if operation.ForTests -%}
    CustomHeaders = new Dictionary<string, string>()
    {
        ["X-Sandbox"]= "allow"
    }
    {%- endif -%}
});
{%- if operation.ForTests -%}
dfsClient.{{ operation.ApiName }}.BaseUrl = "https://sandbox.dataforseo.com";
{%- endif -%}
{%- if operation.HttpMethod == "POST" -%}
var result = await {% if operation.ForTests %}TestHelper.ExecuteWithSandboxFallback(() => {% endif %}dfsClient.{{ operation.ApiName }}.{{ operation.OperationName }}Async(new List<{{ operation.RequestType.SourceType }}>()
{
    new()
    {
        {%- for field in operation.Payload -%}
            {%- assign exampleValue = field.Type.Value -%}
            {%- assign exampleType = field.Type -%}
            {%- assign examplePrefix = field.Name | append: " = " -%}
            {%- assign exampleSuffix = "," -%}
        {% template Part.ExampleValue %}
        {%- endfor -%}
    }
}){% if operation.ForTests %}, () => dfsClient.{{ operation.ApiName }}.BaseUrl = "https://api.dataforseo.com"){% endif %};
{%- else -%}
    {%- if operation.GetParameter != null -%}
var {{ operation.GetParameter.Name }} = {{ operation.GetParameter.Type.Value.Value }};
var result = await {% if operation.ForTests %}TestHelper.ExecuteWithSandboxFallback(() => {% endif %}dfsClient.{{ operation.ApiName }}.{{ operation.OperationName }}Async({{ operation.GetParameter.Name }}){% if operation.ForTests %}, () => dfsClient.{{ operation.ApiName }}.BaseUrl = "https://api.dataforseo.com"){% endif %};
    {%- else -%}
var result = await {% if operation.ForTests %}TestHelper.ExecuteWithSandboxFallback(() => {% endif %}dfsClient.{{ operation.ApiName }}.{{ operation.OperationName }}Async(){% if operation.ForTests %}, () => dfsClient.{{ operation.ApiName }}.BaseUrl = "https://api.dataforseo.com"){% endif %};
    {% endif -%}
{%- endif -%}
